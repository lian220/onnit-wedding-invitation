# CLI · 운영 스크립트만 읽는 비밀값. 브라우저 페이지는 .env 를 못 읽는다 — 공개값은 js/config.js 에 있다.
# 복사: cp .env.example .env   (.env 는 gitignore 되어 있다)
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
# 백업 · psql 용. Session pooler (IPv4) 주소. Direct 가 아니다.
SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
