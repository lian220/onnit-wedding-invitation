# CLI · 운영 스크립트만 읽는 비밀값. 브라우저 페이지는 .env 를 못 읽는다 — 공개값은 js/config.js 에 있다.
# 복사: cp .env.example .env   (.env 는 gitignore 되어 있다)

# ── Supabase (새 계정, org ONNIT) ──
SUPABASE_PROJECT_REF=ehzcybacnnhtyikrpsiy
# 그 계정의 Personal Access Token. 대시보드 → Account → Access Tokens → Generate new token.
# 비우면 scripts/ 가 ~/.config/supabase-accounts/onnit.token 을 읽는다 (switch-supabase 와 같은 파일).
SUPABASE_ACCESS_TOKEN=
# DB 비밀번호는 대시보드가 생성했고 기록하지 않았다. CLI link 나 백업이 필요하면 Settings → Database 에서 재설정해 적는다.
SUPABASE_DB_PASSWORD=
# 백업 · psql 용. Session pooler (IPv4) 주소. Direct 가 아니다.
SUPABASE_DB_URL=

# ── 카카오 로그인 (scripts/supabase-auth.sh 가 Supabase provider 에 넣는다) ──
# 카카오 콘솔 → 앱 ONNIT 청첩장(1597191) → 플랫폼 키 → REST API 키. 공개값(클라이언트 ID).
KAKAO_REST_API_KEY=06475b82e157b5ae2d2d931145bd1b45
# 같은 키 → 더보기 → 수정 → 클라이언트 시크릿 → 카카오 로그인 → 코드. 비밀값.
KAKAO_CLIENT_SECRET=
